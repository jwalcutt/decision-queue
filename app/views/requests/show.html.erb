<% content_for :title, @request.title %>
<% status_classes = {
     "pending" => "bg-gray-100 text-gray-700",
     "accepted" => "bg-green-50 text-green-700",
     "deferred" => "bg-amber-50 text-amber-700",
     "declined" => "bg-red-50 text-red-700"
   } %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl"><%= @request.title %></h1>

  <p class="mt-3 flex items-center gap-3 text-sm">
    <span id="status" class="rounded-full px-2.5 py-0.5 font-medium <%= status_classes[@request.status] %>"><%= @request.status.humanize %></span>
    <span>Urgency: <strong class="font-medium"><%= @request.urgency.humanize %></strong></span>
    <span class="text-gray-500">Submitted <%= @request.created_at.to_date %></span>
  </p>

  <div class="my-6 space-y-5">
    <div>
      <strong class="block font-medium mb-1">Problem statement</strong>
      <p><%= @request.problem_statement %></p>
    </div>
    <div>
      <strong class="block font-medium mb-1">Expected impact</strong>
      <p><%= @request.expected_impact %></p>
    </div>
  </div>

  <section id="decision_history" class="my-8">
    <h2 class="font-bold text-2xl mb-3">Decision history</h2>
    <% if @request.decisions.any? %>
      <ol class="space-y-3">
        <% @request.decisions.each do |decision| %>
          <li class="rounded-md border border-gray-200 px-4 py-3">
            <p class="text-sm">
              <strong class="font-medium"><%= decision.decision_type.humanize %></strong>
              <span class="text-gray-500"><%= decision.created_at.to_date %></span>
            </p>
            <p class="mt-1"><%= decision.reason %></p>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="text-gray-500">No decisions yet.</p>
    <% end %>
  </section>

  <section id="decision_form" class="my-8">
    <% if @request.decidable? %>
    <h2 class="font-bold text-2xl mb-3">Record a decision</h2>

    <%= form_with(model: [ @request, @decision ], class: "contents") do |form| %>
      <% if @decision.errors.any? %>
        <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
          <h3>This decision couldn't be saved:</h3>
          <ul class="list-disc ml-6">
            <% @decision.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <fieldset class="my-5">
        <legend class="mb-2">Decision</legend>
        <div class="flex gap-6">
          <% { "accepted" => "Accept", "deferred" => "Defer", "declined" => "Decline" }.each do |value, label| %>
            <label class="flex items-center gap-2">
              <%= form.radio_button :decision_type, value %>
              <%= label %>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="my-5">
        <%= form.label :reason %>
        <%= form.textarea :reason, rows: 3, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": @decision.errors[:reason].none?, "border-red-400 focus:outline-red-600": @decision.errors[:reason].any?}] %>
      </div>

      <div class="inline">
        <%= form.submit "Record decision", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
      </div>
    <% end %>
    <% else %>
    <p class="text-gray-500">This request is <%= @request.status %>. Accepted and declined decisions are final.</p>
    <% end %>
  </section>

  <%= link_to "Back to queue", root_path, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
