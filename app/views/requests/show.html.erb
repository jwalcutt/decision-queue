<% content_for :title, @request.title %>

<% back_to_queue = link_to "Back to queue", root_path, data: { controller: "escape-link", action: "keydown.esc@window->escape-link#follow" }, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-800 hover:bg-gray-700 inline-block font-medium" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-950 mb-5 text-green-300 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl"><%= @request.title %></h1>

  <p class="mt-3 flex items-center gap-3 text-sm">
    <%= status_badge(@request.status, id: "status") %>
    <%= urgency_badge(@request.urgency) %>
    <span class="text-gray-400">Submitted <time datetime="<%= @request.created_at.iso8601 %>"><%= @request.created_at.to_fs(:long) %></time></span>
  </p>

  <section class="my-8">
    <h2 class="font-bold text-2xl mb-3">Problem statement</h2>
    <p><%= @request.problem_statement %></p>
  </section>

  <section class="my-8">
    <h2 class="font-bold text-2xl mb-3">Expected impact</h2>
    <p><%= @request.expected_impact %></p>
  </section>

  <section id="decision_history" class="my-8">
    <h2 class="font-bold text-2xl mb-3">Decision history</h2>
    <% if @request.decisions.any? %>
      <ol class="space-y-3">
        <% @request.decisions.each do |decision| %>
          <li data-decision-type="<%= decision.decision_type %>" class="rounded-md border border-gray-800 px-4 py-3">
            <p class="text-sm">
              <strong class="font-medium"><%= decision.decision_type.humanize %></strong>
              <time datetime="<%= decision.created_at.iso8601 %>" class="text-gray-400"><%= decision.created_at.to_fs(:long) %></time>
            </p>
            <p class="mt-1"><%= decision.reason %></p>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="text-gray-400">No decisions yet.</p>
    <% end %>
  </section>

  <% if @request.decidable? %>
  <div id="decision_form" data-controller="dialog" data-dialog-open-value="<%= @decision.errors.any? %>" class="flex flex-wrap gap-3 my-8">
    <button type="button" data-action="dialog#open" class="w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer">Record a decision</button>
    <%= back_to_queue %>

    <dialog data-dialog-target="dialog" data-action="click->dialog#closeOnBackdrop keydown.esc->dialog#close" class="m-auto w-full max-w-md rounded-lg border border-gray-700 bg-gray-900 p-6 text-gray-100 backdrop:bg-black/60">
      <h2 class="font-bold text-2xl mb-4">Record a decision</h2>

      <%= form_with(model: [ @request, @decision ], class: "space-y-4") do |form| %>
        <% if @decision.errors.any? %>
          <div id="error_explanation" class="bg-red-950 text-red-300 px-3 py-2 font-medium rounded-md">
            <h3>This decision couldn't be saved:</h3>
            <ul class="list-disc ml-6">
              <% @decision.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <fieldset>
          <legend class="block text-sm text-gray-400 mb-2">Decision</legend>
          <div class="flex gap-6">
            <% { "accepted" => "Accept", "deferred" => "Defer", "declined" => "Decline" }.each do |value, label| %>
              <label class="flex items-center gap-2">
                <%= form.radio_button :decision_type, value %>
                <%= label %>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div>
          <%= form.label :reason, class: "block text-sm text-gray-400 mb-1" %>
          <%= form.textarea :reason, rows: 3, class: ["block shadow-sm rounded-md border bg-gray-900 px-3 py-2 w-full", {"border-gray-600 focus:outline-blue-500": @decision.errors[:reason].none?, "border-red-500 focus:outline-red-500": @decision.errors[:reason].any?}] %>
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <button type="button" data-action="dialog#close" class="rounded-md px-3.5 py-2.5 bg-gray-800 hover:bg-gray-700 font-medium cursor-pointer">Cancel</button>
          <%= form.submit "Record decision", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
        </div>
      <% end %>
    </dialog>
  </div>
  <% else %>
    <% if @decision.errors.any? %>
      <div id="error_explanation" class="bg-red-950 text-red-300 px-3 py-2 font-medium rounded-md my-8">
        <ul class="list-disc ml-6">
          <% @decision.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <%= back_to_queue %>
  <% end %>
</div>
