<% content_for :title, "New request" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">New request</h1>

  <%= render "form", request: @request %>

  <%= link_to "Back to requests", requests_path, data: { controller: "escape-link", action: "keydown.esc@window->escape-link#follow" }, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
