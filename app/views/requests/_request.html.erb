<div id="<%= dom_id request %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= request.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Problem statement:</strong>
    <%= request.problem_statement %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Expected impact:</strong>
    <%= request.expected_impact %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Urgency:</strong>
    <%= request.urgency %>
  </div>
</div>
